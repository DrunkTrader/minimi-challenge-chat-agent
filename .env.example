# Copy to .env and fill in. Every key below has a free tier, no credit card needed.

# --- LLMs (at least one required) -------------------------------------------
# Google AI Studio: https://aistudio.google.com/apikey  (used for answers)
GEMINI_API_KEY=
# Groq: https://console.groq.com/keys  (used for the fast planner + memory extraction)
GROQ_API_KEY=
# Optional (paid). OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Optional (paid, cheap). DeepSeek: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
# Optional extra fallback: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# --- Web search (at least one required) -------------------------------------
# Tavily: https://app.tavily.com  (primary)
TAVILY_API_KEY=
# Exa: https://dashboard.exa.ai  (optional fallback)
EXA_API_KEY=

# --- Optional overrides ------------------------------------------------------
# Comma-separated model lists; the first that works wins (handles retired model names).
# FAST_MODELS_GROQ=openai/gpt-oss-20b,qwen/qwen3.8-27b,openai/gpt-oss-120b
# ANSWER_MODELS_GEMINI=gemini-3.5-flash,gemini-flash-lite-latest,gemini-flash-latest
# Any OpenAI-compatible server instead of api.openai.com (Ollama: http://localhost:11434/v1, any key):
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODELS=gpt-5-mini,gpt-4.1-mini
# DEEPSEEK_MODELS=deepseek-chat
# Which provider each role tries first (the rest follow as fallbacks):
# LLM_ORDER_FAST=groq,openai,deepseek,gemini,openrouter
# LLM_ORDER_ANSWER=gemini,openai,deepseek,groq,openrouter
# Gemini thinking before answering: none (fastest, default) | low | medium | high | default
# GEMINI_REASONING=none
# OPENROUTER_MODELS=meta-llama/llama-3.3-70b-instruct:free
# PORT=3000
# DB_PATH=data/memory.db
# Freeze "now" (ISO time) for demos/evals, e.g. NOW=2026-11-12T10:00:00+05:30
# NOW=
