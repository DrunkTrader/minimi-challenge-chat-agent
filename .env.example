# Copy to .env and fill in. Every key below has a free tier, no credit card needed.

# --- LLMs (at least one required) -------------------------------------------
# Google AI Studio: https://aistudio.google.com/apikey  (used for answers)
GEMINI_API_KEY=
# Groq: https://console.groq.com/keys  (used for the fast planner + memory extraction)
GROQ_API_KEY=
# Optional extra fallback: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# --- Web search (at least one required) -------------------------------------
# Tavily: https://app.tavily.com  (primary)
TAVILY_API_KEY=
# Exa: https://dashboard.exa.ai  (optional fallback)
EXA_API_KEY=

# --- Optional overrides ------------------------------------------------------
# Comma-separated model lists; the first that works wins (handles retired model names).
# FAST_MODELS_GROQ=openai/gpt-oss-20b,llama-3.3-70b-versatile,llama-3.1-8b-instant
# ANSWER_MODELS_GEMINI=gemini-flash-latest,gemini-2.5-flash
# OPENROUTER_MODELS=meta-llama/llama-3.3-70b-instruct:free
# PORT=3000
# DB_PATH=data/memory.db
# Freeze "now" (ISO time) for demos/evals, e.g. NOW=2026-11-12T10:00:00+05:30
# NOW=
